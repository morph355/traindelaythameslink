# Realtime Trains API (https://api-portal.rtt.io/) credentials.
# Sign up for a free personal-use account, then use your account
# username and the API password shown on your account page (not your
# login password).
RTT_USERNAME=
RTT_PASSWORD=

# AgentMail (https://agentmail.to/) - the inbox TrainPal e-tickets get
# forwarded to. Get your API key from the AgentMail dashboard for the
# account that owns AGENTMAIL_INBOX_ID.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=thameslink-tickets@agentmail.to
# Comma-separated substrings to match the sender of ticket emails.
AGENTMAIL_TICKET_SENDERS=trainpal

# Your own email address - only emails FROM this address to the inbox
# above are treated as "check my journey" requests (see README). Leave
# blank to disable the email-checking feature entirely.
AGENTMAIL_OWNER_EMAIL=
# How often (seconds) to check the inbox for new requests.
AGENTMAIL_POLL_SECONDS=60

# Required if this app is reachable from outside your LAN (e.g. via a
# reverse proxy) - gates every request behind HTTP Basic Auth. Leave both
# blank for LAN-only/local use; the app then has no password at all.
APP_USERNAME=
APP_PASSWORD=

# Where the app is reachable (e.g. https://yourname.synology.me) - included
# as a link in email replies. Leave blank to omit the link.
APP_URL=

PORT=3000
