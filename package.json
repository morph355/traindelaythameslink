{
  "name": "traindelaythameslink",
  "version": "0.1.0",
  "private": true,
  "description": "Checks Thameslink journeys (including split-ticket legs) for Delay Repay eligibility using actual train performance data, and drafts a claim.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server/index.ts",
    "start": "node --env-file=.env dist/server/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "agentmail": "^0.5.27",
    "express": "^4.19.2",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
